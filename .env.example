# Local development values only. Replace passwords and keys before use.
LAKEHOUSE_SOURCE_MONTHS=2024-01,2024-02
LAKEHOUSE_LOG_LEVEL=INFO

# MinIO object storage
MINIO_ROOT_USER=lakehouse_admin
MINIO_ROOT_PASSWORD=local-minio-password-change-me

# Hive Metastore PostgreSQL database
HIVE_DB_USER=lakehouse_hive
HIVE_DB_PASSWORD=local-hive-password-change-me

# Airflow metadata database and local web login
AIRFLOW_DB_USER=lakehouse_airflow
AIRFLOW_DB_PASSWORD=local-airflow-db-password-change-me
AIRFLOW_UI_USERNAME=lakehouse
AIRFLOW_UI_PASSWORD=local-airflow-ui-password-change-me
AIRFLOW_FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AIRFLOW_API_SECRET_KEY=replace-this-local-airflow-api-secret-with-a-long-random-value
AIRFLOW_JWT_SECRET=replace-this-local-airflow-jwt-secret-with-a-long-random-value-of-at-least-64-characters

# Grafana local UI login
GRAFANA_ADMIN_USER=lakehouse
GRAFANA_ADMIN_PASSWORD=local-grafana-password-change-me
